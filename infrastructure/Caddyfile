brand.bybor.cc {
    encode zstd gzip
    root * /srv/brand/public
    @entry path / /index.html
    header @entry Cache-Control "no-cache"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; script-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    file_server
}
